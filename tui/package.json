{
  "name": "twilioworld-toolkit-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTUI dashboard for the TwilioWorld Agentic Coding Toolkit.",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "TOOLKIT_TUI_SMOKE=1 bun run src/index.ts"
  },
  "dependencies": {
    "@opentui/core": "0.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
